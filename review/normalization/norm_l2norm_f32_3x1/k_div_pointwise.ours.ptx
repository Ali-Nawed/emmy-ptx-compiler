.version 8.0
.target sm_89
.address_size 64

.visible .entry k_div_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1
)
{
    .reg .b32 %r<11>;
    .reg .b64 %rd<9>;
    .reg .f32 %f<5>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 3;
    @%p1 bra DONE;
    mul.lo.s32 %r5, %r4, 1;
    add.s32 %r6, %r5, 0;
    mov.s32 %r7, %r6;
    mul.wide.s32 %rd5, %r7, 4;
    add.u64 %rd6, %rd2, %rd5;
    ld.global.f32 %f1, [%rd6+0];
    mul.rn.f32 %f2, %f1, %f1;
    sqrt.rn.f32 %f3, %f2;
    div.rn.f32 %f4, %f1, %f3;
    mul.lo.s32 %r8, %r4, 1;
    add.s32 %r9, %r8, 0;
    mov.s32 %r10, %r9;
    mul.wide.s32 %rd7, %r10, 4;
    add.u64 %rd8, %rd4, %rd7;
    st.global.f32 [%rd8+0], %f4;
DONE:
    ret;
}
