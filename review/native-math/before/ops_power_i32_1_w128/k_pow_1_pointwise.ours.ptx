.version 8.0
.target sm_89
.address_size 64

.visible .entry k_pow_1_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1,
    .param .u64 arg_2
)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<13>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64 %rd5, [arg_2];
    cvta.to.global.u64 %rd6, %rd5;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 1;
    @%p1 bra DONE;
    mov.s32 %r5, 0;
    mul.wide.s32 %rd7, %r5, 4;
    add.u64 %rd8, %rd2, %rd7;
    ld.global.s32 %r6, [%rd8+0];
    mul.lo.s32 %r7, %r6, %r6;
    mov.s32 %r8, 0;
    mul.wide.s32 %rd9, %r8, 4;
    add.u64 %rd10, %rd4, %rd9;
    ld.global.s32 %r9, [%rd10+0];
    mov.s32 %r11, 1;
    mov.s32 %r12, %r9;
    mov.s32 %r13, %r7;
IPOW_1:
    setp.eq.s32 %p2, %r13, 0;
    @%p2 bra IPOW_DONE_2;
    and.b32 %r14, %r13, 1;
    setp.ne.s32 %p3, %r14, 0;
    @%p3 mul.lo.s32 %r11, %r11, %r12;
    mul.lo.s32 %r12, %r12, %r12;
    shr.u32 %r13, %r13, 1;
    bra IPOW_1;
IPOW_DONE_2:
    mov.s32 %r15, 0;
    mul.wide.s32 %rd11, %r15, 4;
    add.u64 %rd12, %rd6, %rd11;
    st.global.s32 [%rd12+0], %r11;
DONE:
    ret;
}
