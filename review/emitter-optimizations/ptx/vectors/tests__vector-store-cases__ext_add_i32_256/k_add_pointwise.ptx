    mul.wide.s32 %rd9, %r11, 4;
    add.u64 %rd10, %rd4, %rd9;
    ld.global.s32 %r12, [%rd10+0];
    add.s32 %r13, %r8, %r12;
    mul.lo.s32 %r14, %r4, 2;
    add.s32 %r15, %r14, 1;
    mov.s32 %r16, %r15;
    mul.wide.s32 %rd11, %r16, 4;
    add.u64 %rd12, %rd2, %rd11;
    ld.global.s32 %r17, [%rd12+0];
    mul.lo.s32 %r18, %r4, 2;
    add.s32 %r19, %r18, 1;
    mov.s32 %r20, %r19;
    mul.wide.s32 %rd13, %r20, 4;
    add.u64 %rd14, %rd4, %rd13;
