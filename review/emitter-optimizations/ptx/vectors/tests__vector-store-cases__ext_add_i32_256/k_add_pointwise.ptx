    mul.wide.s32 %rd15, %r25, 4;
    add.u64 %rd16, %rd6, %rd15;
    st.global.s32 [%rd16+0], %r13;
    mul.lo.s32 %r26, %r4, 2;
    add.s32 %r27, %r26, 1;
    mov.s32 %r28, %r27;
    mul.wide.s32 %rd17, %r28, 4;
    add.u64 %rd18, %rd6, %rd17;
