    @%p1 bra DONE;
    mul.lo.s32 %r5, %r4, 2;
    add.s32 %r6, %r5, 0;
    mov.s32 %r7, %r6;
    mul.wide.s32 %rd7, %r7, 4;
    add.u64 %rd8, %rd2, %rd7;
    ld.global.s32 %r8, [%rd8+0];
