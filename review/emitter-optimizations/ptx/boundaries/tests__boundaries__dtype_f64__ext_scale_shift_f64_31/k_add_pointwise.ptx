.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1,
    .param .u64 arg_2,
    .param .u64 arg_3
)
{
    .reg .b32 %r<9>;
    .reg .b64 %rd<17>;
    .reg .f64 %d<6>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64 %rd5, [arg_2];
    cvta.to.global.u64 %rd6, %rd5;
    ld.param.u64 %rd7, [arg_3];
    cvta.to.global.u64 %rd8, %rd7;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 31;
    @%p1 bra DONE;
    mov.s32 %r5, 0;
    mul.wide.s32 %rd9, %r5, 8;
    add.u64 %rd10, %rd2, %rd9;
    ld.global.f64 %d1, [%rd10+0];
    mov.s32 %r6, %r4;
    mul.wide.s32 %rd11, %r6, 8;
    add.u64 %rd12, %rd6, %rd11;
    ld.global.f64 %d2, [%rd12+0];
    mul.rn.f64 %d3, %d1, %d2;
    mov.s32 %r7, 0;
    mul.wide.s32 %rd13, %r7, 8;
    add.u64 %rd14, %rd4, %rd13;
    ld.global.f64 %d4, [%rd14+0];
    add.rn.f64 %d5, %d4, %d3;
    mov.s32 %r8, %r4;
    mul.wide.s32 %rd15, %r8, 8;
    add.u64 %rd16, %rd8, %rd15;
    st.global.f64 [%rd16+0], %d5;
DONE:
    ret;
}
