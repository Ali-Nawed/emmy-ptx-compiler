LOOP_DONE_2:
    activemask.b32 %r9;
    shfl.sync.bfly.b32 %f4, %f1, 16, 31, %r9;
    add.rn.f32 %f5, %f1, %f4;
    mov.f32 %f1, %f5;
    shfl.sync.bfly.b32 %f6, %f1, 8, 31, %r9;
