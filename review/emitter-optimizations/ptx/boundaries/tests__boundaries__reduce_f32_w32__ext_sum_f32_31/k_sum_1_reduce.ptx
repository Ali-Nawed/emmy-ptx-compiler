    .reg .f32 %f<14>;
    .reg .pred %p<3>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    and.b32 %r5, %r1, 31;
    shr.u32 %r6, %r1, 5;
    mov.f32 %f1, 0f00000000;
    mov.s32 %r7, %r4;
LOOP_1:
    setp.ge.s32 %p1, %r7, 31;
    @%p1 bra LOOP_DONE_2;
    mov.s32 %r8, %r7;
    mul.wide.s32 %rd5, %r8, 4;
    add.u64 %rd6, %rd2, %rd5;
    ld.global.f32 %f2, [%rd6+0];
    add.rn.f32 %f3, %f1, %f2;
    mov.f32 %f1, %f3;
    add.s32 %r7, %r7, 32;
