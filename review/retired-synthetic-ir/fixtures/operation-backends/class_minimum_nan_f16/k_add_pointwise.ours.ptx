.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1,
    .param .u64 arg_2
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<13>;
    .reg .f32 %f<8>;
    .reg .b16 %h<5>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64 %rd5, [arg_2];
    cvta.to.global.u64 %rd6, %rd5;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 8;
    @%p1 bra DONE;
    mov.s32 %r5, %r4;
    mul.wide.s32 %rd7, %r5, 2;
    add.u64 %rd8, %rd2, %rd7;
    ld.global.b16 %h1, [%rd8+0];
    cvt.f32.f16 %f1, %h1;
    mov.s32 %r6, %r4;
    mul.wide.s32 %rd9, %r6, 2;
    add.u64 %rd10, %rd4, %rd9;
    ld.global.b16 %h2, [%rd10+0];
    cvt.f32.f16 %f2, %h2;
    sqrt.rn.f32 %f3, %f1;
    cvt.rn.f16.f32 %h3, %f3;
    cvt.f32.f16 %f4, %h3;
    setp.lt.f32 %p2, %f4, %f2;
    selp.f32 %f5, %f4, %f2, %p2;
    setp.nan.f32 %p3, %f4, %f2;
    @%p3 mov.f32 %f5, 0f7FC00000;
    cvt.rn.f16.f32 %h4, %f5;
    cvt.f32.f16 %f6, %h4;
    mov.f32 %f7, %f6;
    mov.b32 %r7, %f7;
    mov.s32 %r8, %r7;
    mov.s32 %r9, %r4;
    mul.wide.s32 %rd11, %r9, 4;
    add.u64 %rd12, %rd6, %rd11;
    st.global.s32 [%rd12+0], %r8;
DONE:
    ret;
}
