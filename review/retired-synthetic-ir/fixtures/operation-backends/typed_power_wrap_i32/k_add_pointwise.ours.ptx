.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1,
    .param .u64 arg_2
)
{
    .reg .b32 %r<15>;
    .reg .b64 %rd<13>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64 %rd5, [arg_2];
    cvta.to.global.u64 %rd6, %rd5;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 5;
    @%p1 bra DONE;
    mov.s32 %r5, %r4;
    mul.wide.s32 %rd7, %r5, 4;
    add.u64 %rd8, %rd2, %rd7;
    ld.global.s32 %r6, [%rd8+0];
    mov.s32 %r7, %r4;
    mul.wide.s32 %rd9, %r7, 4;
    add.u64 %rd10, %rd4, %rd9;
    ld.global.s32 %r8, [%rd10+0];
    mov.s32 %r10, 1;
    mov.s32 %r11, %r6;
    mov.s32 %r12, %r8;
IPOW_1:
    setp.eq.s32 %p2, %r12, 0;
    @%p2 bra IPOW_DONE_2;
    and.b32 %r13, %r12, 1;
    setp.ne.s32 %p3, %r13, 0;
    @%p3 mul.lo.s32 %r10, %r10, %r11;
    mul.lo.s32 %r11, %r11, %r11;
    shr.u32 %r12, %r12, 1;
    bra IPOW_1;
IPOW_DONE_2:
    mov.s32 %r14, %r4;
    mul.wide.s32 %rd11, %r14, 4;
    add.u64 %rd12, %rd6, %rd11;
    st.global.s32 [%rd12+0], %r10;
DONE:
    ret;
}
