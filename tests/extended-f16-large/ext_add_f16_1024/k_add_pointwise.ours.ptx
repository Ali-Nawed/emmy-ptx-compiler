.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1,
    .param .u64 arg_2
)
{
    .reg .b32 %r<20>;
    .reg .b64 %rd<17>;
    .reg .f32 %f<9>;
    .reg .b16 %h<9>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64 %rd5, [arg_2];
    cvta.to.global.u64 %rd6, %rd5;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 512;
    @%p1 bra DONE;
    mul.lo.s32 %r5, %r4, 2;
    add.s32 %r6, %r5, 0;
    mov.s32 %r7, %r6;
    mul.wide.s32 %rd7, %r7, 2;
    add.u64 %rd8, %rd2, %rd7;
    ld.global.b16 %h1, [%rd8+0];
    cvt.f32.f16 %f1, %h1;
    mul.lo.s32 %r8, %r4, 2;
    add.s32 %r9, %r8, 0;
    mov.s32 %r10, %r9;
    mul.wide.s32 %rd9, %r10, 2;
    add.u64 %rd10, %rd4, %rd9;
    ld.global.b16 %h2, [%rd10+0];
    cvt.f32.f16 %f2, %h2;
    add.rn.f32 %f3, %f1, %f2;
    cvt.rn.f16.f32 %h3, %f3;
    cvt.f32.f16 %f4, %h3;
    mul.lo.s32 %r11, %r4, 2;
    add.s32 %r12, %r11, 1;
    mov.s32 %r13, %r12;
    mul.wide.s32 %rd11, %r13, 2;
    add.u64 %rd12, %rd2, %rd11;
    ld.global.b16 %h4, [%rd12+0];
    cvt.f32.f16 %f5, %h4;
    mul.lo.s32 %r14, %r4, 2;
    add.s32 %r15, %r14, 1;
    mov.s32 %r16, %r15;
    mul.wide.s32 %rd13, %r16, 2;
    add.u64 %rd14, %rd4, %rd13;
    ld.global.b16 %h5, [%rd14+0];
    cvt.f32.f16 %f6, %h5;
    add.rn.f32 %f7, %f5, %f6;
    cvt.rn.f16.f32 %h6, %f7;
    cvt.f32.f16 %f8, %h6;
    mul.lo.s32 %r17, %r4, 2;
    add.s32 %r18, %r17, 0;
    mov.s32 %r19, %r18;
    mul.wide.s32 %rd15, %r19, 2;
    add.u64 %rd16, %rd6, %rd15;
    cvt.rn.f16.f32 %h7, %f4;
    st.global.b16 [%rd16+0], %h7;
    cvt.rn.f16.f32 %h8, %f8;
    st.global.b16 [%rd16+2], %h8;
DONE:
    ret;
}

