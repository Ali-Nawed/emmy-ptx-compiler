.version 8.0
.target sm_89
.address_size 64

.visible .entry k_sum_1_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1
)
{
    .reg .b32 %r<7>;
    .reg .b64 %rd<9>;
    .reg .f64 %d<2>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 1;
    @%p1 bra DONE;
    mov.s32 %r5, 0;
    mul.wide.s32 %rd5, %r5, 8;
    add.u64 %rd6, %rd2, %rd5;
    ld.global.f64 %d1, [%rd6+0];
    mov.s32 %r6, 0;
    mul.wide.s32 %rd7, %r6, 8;
    add.u64 %rd8, %rd4, %rd7;
    st.global.f64 [%rd8+0], %d1;
DONE:
    ret;
}

