.version 8.0
.target sm_89
.address_size 64

.visible .entry k_sum_1_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1,
    .param .u64 arg_2,
    .param .u64 arg_3
)
{
    .reg .b32 %r<13>;
    .reg .b64 %rd<17>;
    .reg .f64 %d<8>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64 %rd5, [arg_2];
    cvta.to.global.u64 %rd6, %rd5;
    ld.param.u64 %rd7, [arg_3];
    cvta.to.global.u64 %rd8, %rd7;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 3;
    @%p1 bra DONE;
    mul.lo.s32 %r5, %r4, 1;
    add.s32 %r6, %r5, 0;
    mov.s32 %r7, %r6;
    mul.wide.s32 %rd9, %r7, 8;
    add.u64 %rd10, %rd4, %rd9;
    ld.global.f64 %d1, [%rd10+0];
    mul.rn.f64 %d2, %d1, %d1;
    mov.s32 %r8, 0;
    mul.wide.s32 %rd11, %r8, 8;
    add.u64 %rd12, %rd2, %rd11;
    ld.global.f64 %d3, [%rd12+0];
    add.rn.f64 %d4, %d3, %d2;
    mul.lo.s32 %r9, %r4, 1;
    add.s32 %r10, %r9, 0;
    mov.s32 %r11, %r10;
    mul.wide.s32 %rd13, %r11, 8;
    add.u64 %rd14, %rd6, %rd13;
    ld.global.f64 %d5, [%rd14+0];
    sub.rn.f64 %d6, %d5, %d1;
    div.rn.f64 %d7, %d6, %d4;
    mov.s32 %r12, %r4;
    mul.wide.s32 %rd15, %r12, 8;
    add.u64 %rd16, %rd8, %rd15;
    st.global.f64 [%rd16+0], %d7;
DONE:
    ret;
}
