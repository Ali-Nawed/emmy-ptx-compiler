    mov.s32 %r14, 0;
    mul.wide.s32 %rd19, %r14, 4;
    add.u64 %rd20, %rd4, %rd19;
    ld.global.f32 %f9, [%rd20+0];
    add.rn.f32 %f10, %f9, %f8;
    mul.lo.s32 %r15, %r4, 2;
    add.s32 %r16, %r15, 0;
    mov.s32 %r17, %r16;
    mul.wide.s32 %rd21, %r17, 4;
    add.u64 %rd22, %rd8, %rd21;
    st.global.f32 [%rd22+0], %f5;
    st.global.f32 [%rd22+4], %f10;
