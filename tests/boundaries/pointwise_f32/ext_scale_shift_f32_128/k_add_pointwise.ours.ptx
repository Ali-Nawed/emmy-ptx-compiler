    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 64;
    @%p1 bra DONE;
    mov.s32 %r5, 0;
    mul.wide.s32 %rd9, %r5, 4;
    add.u64 %rd10, %rd2, %rd9;
    ld.global.f32 %f1, [%rd10+0];
    mul.lo.s32 %r6, %r4, 2;
    add.s32 %r7, %r6, 0;
    mov.s32 %r8, %r7;
    mul.wide.s32 %rd11, %r8, 4;
    add.u64 %rd12, %rd6, %rd11;
    ld.global.f32 %f2, [%rd12+0];
    mul.rn.f32 %f3, %f1, %f2;
    mov.s32 %r9, 0;
    mul.wide.s32 %rd13, %r9, 4;
    add.u64 %rd14, %rd4, %rd13;
    ld.global.f32 %f4, [%rd14+0];
    add.rn.f32 %f5, %f4, %f3;
    mov.s32 %r10, 0;
    mul.wide.s32 %rd15, %r10, 4;
    add.u64 %rd16, %rd2, %rd15;
    ld.global.f32 %f6, [%rd16+0];
    mul.lo.s32 %r11, %r4, 2;
    add.s32 %r12, %r11, 1;
    mov.s32 %r13, %r12;
    mul.wide.s32 %rd17, %r13, 4;
    add.u64 %rd18, %rd6, %rd17;
    ld.global.f32 %f7, [%rd18+0];
