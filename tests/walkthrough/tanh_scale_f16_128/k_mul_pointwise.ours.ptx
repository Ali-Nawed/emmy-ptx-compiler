.version 8.0
.target sm_89
.address_size 64

.visible .entry k_mul_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1,
    .param .u64 arg_2
)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<17>;
    .reg .f32 %f<15>;
    .reg .b16 %h<11>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64 %rd5, [arg_2];
    cvta.to.global.u64 %rd6, %rd5;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 64;
    @%p1 bra DONE;
    mul.lo.s32 %r5, %r4, 2;
    add.s32 %r6, %r5, 0;
    mov.s32 %r7, %r6;
    mul.wide.s32 %rd7, %r7, 2;
    add.u64 %rd8, %rd4, %rd7;
    ld.global.b16 %h1, [%rd8+0];
    cvt.f32.f16 %f1, %h1;
    tanh.approx.f32 %f3, %f1;
    cvt.rn.f16.f32 %h2, %f3;
    cvt.f32.f16 %f4, %h2;
    mov.s32 %r8, 0;
    mul.wide.s32 %rd9, %r8, 2;
    add.u64 %rd10, %rd2, %rd9;
    ld.global.b16 %h3, [%rd10+0];
    cvt.f32.f16 %f5, %h3;
    mul.rn.f32 %f6, %f5, %f4;
    cvt.rn.f16.f32 %h4, %f6;
    cvt.f32.f16 %f7, %h4;
    mul.lo.s32 %r9, %r4, 2;
    add.s32 %r10, %r9, 1;
    mov.s32 %r11, %r10;
    mul.wide.s32 %rd11, %r11, 2;
    add.u64 %rd12, %rd4, %rd11;
    ld.global.b16 %h5, [%rd12+0];
    cvt.f32.f16 %f8, %h5;
    tanh.approx.f32 %f10, %f8;
    cvt.rn.f16.f32 %h6, %f10;
    cvt.f32.f16 %f11, %h6;
    mov.s32 %r12, 0;
    mul.wide.s32 %rd13, %r12, 2;
    add.u64 %rd14, %rd2, %rd13;
    ld.global.b16 %h7, [%rd14+0];
    cvt.f32.f16 %f12, %h7;
    mul.rn.f32 %f13, %f12, %f11;
    cvt.rn.f16.f32 %h8, %f13;
    cvt.f32.f16 %f14, %h8;
    mul.lo.s32 %r13, %r4, 2;
    add.s32 %r14, %r13, 0;
    mov.s32 %r15, %r14;
    mul.wide.s32 %rd15, %r15, 2;
    add.u64 %rd16, %rd6, %rd15;
    cvt.rn.f16.f32 %h9, %f7;
    cvt.rn.f16.f32 %h10, %f14;
    st.global.v2.b16 [%rd16], {%h9, %h10};
DONE:
    ret;
}
