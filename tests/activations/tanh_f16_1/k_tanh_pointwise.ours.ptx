.version 8.0
.target sm_89
.address_size 64

.visible .entry k_tanh_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1
)
{
    .reg .b32 %r<7>;
    .reg .b64 %rd<9>;
    .reg .f32 %f<5>;
    .reg .b16 %h<4>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 1;
    @%p1 bra DONE;
    mov.s32 %r5, 0;
    mul.wide.s32 %rd5, %r5, 2;
    add.u64 %rd6, %rd2, %rd5;
    ld.global.b16 %h1, [%rd6+0];
    cvt.f32.f16 %f1, %h1;
    tanh.approx.f32 %f3, %f1;
    cvt.rn.f16.f32 %h2, %f3;
    cvt.f32.f16 %f4, %h2;
    mov.s32 %r6, 0;
    mul.wide.s32 %rd7, %r6, 2;
    add.u64 %rd8, %rd4, %rd7;
    cvt.rn.f16.f32 %h3, %f4;
    st.global.b16 [%rd8+0], %h3;
DONE:
    ret;
}
