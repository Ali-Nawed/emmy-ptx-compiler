.version 8.0
.target sm_89
.address_size 64

.visible .entry k_tanh_pointwise(
    .param .u64 arg_0,
    .param .u64 arg_1
)
{
    .reg .b32 %r<11>;
    .reg .b64 %rd<9>;
    .reg .f32 %f<9>;
    .reg .b16 %h<7>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [arg_0];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64 %rd3, [arg_1];
    cvta.to.global.u64 %rd4, %rd3;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.s32 %r4, %r2, %r3, %r1;
    setp.ge.u32 %p1, %r4, 13;
    @%p1 bra DONE;
    mul.lo.s32 %r5, %r4, 2;
    add.s32 %r6, %r5, 0;
    mov.s32 %r7, %r6;
    mul.wide.s32 %rd5, %r7, 2;
    add.u64 %rd6, %rd2, %rd5;
    ld.global.b16 %h1, [%rd6+0];
    cvt.f32.f16 %f1, %h1;
    ld.global.b16 %h2, [%rd6+2];
    cvt.f32.f16 %f2, %h2;
    tanh.approx.f32 %f4, %f1;
    cvt.rn.f16.f32 %h3, %f4;
    cvt.f32.f16 %f5, %h3;
    tanh.approx.f32 %f7, %f2;
    cvt.rn.f16.f32 %h4, %f7;
    cvt.f32.f16 %f8, %h4;
    mul.lo.s32 %r8, %r4, 2;
    add.s32 %r9, %r8, 0;
    mov.s32 %r10, %r9;
    mul.wide.s32 %rd7, %r10, 2;
    add.u64 %rd8, %rd4, %rd7;
    cvt.rn.f16.f32 %h5, %f5;
    cvt.rn.f16.f32 %h6, %f8;
    st.global.v2.b16 [%rd8], {%h5, %h6};
DONE:
    ret;
}
